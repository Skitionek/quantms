/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running on HPC clusters using Apptainer
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    This profile is designed for generic HPC clusters running SLURM and using
    Apptainer (the open-source successor to Singularity) as the container engine.

    Usage:
        nextflow run bigbio/quantms \
            -profile hpc_apptainer \
            --input project.sdrf.tsv \
            --database database.fasta \
            --outdir <OUTDIR>

    Configuration:
        The following parameters can be used to customise the profile:

        --apptainer_cache_dir   Path to the directory where Apptainer images are
                                cached (default: $HOME/.apptainer/cache).
        --apptainer_bind_dir    Path to bind-mount into the container, if your
                                input/output data is on a filesystem that Apptainer
                                does not auto-mount (default: null, no extra bind).

~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_description = 'Generic HPC cluster profile using Apptainer and SLURM'
    config_profile_url         = 'https://apptainer.org/'
    config_profile_contact     = 'https://github.com/bigbio/quantms/issues'

    // Optional: Path to a directory where Apptainer images should be cached.
    // Override via --apptainer_cache_dir on the command line.
    apptainer_cache_dir        = null

    // Optional: Extra bind-mount path (e.g. a shared project directory).
    // When set, this path is passed to apptainer.runOptions as --bind <path>.
    // Override via --apptainer_bind_dir on the command line.
    apptainer_bind_dir         = null
}

apptainer {
    enabled     = true
    autoMounts  = true
    // Increase timeout from the default 20 min — large images can take much longer to pull.
    pullTimeout = '3 hours'
    cacheDir    = params.apptainer_cache_dir ?: "${HOME}/.apptainer/cache"
    runOptions  = params.apptainer_bind_dir ? "--bind ${params.apptainer_bind_dir}:${params.apptainer_bind_dir}" : ''
}

process {
    maxRetries    = 5
    // Retry on transient HPC failures.  The exit-code groups cover:
    //   130-145 : SLURM-issued signals (SIGUSR1=138, SIGUSR2=139, SIGTERM=143, etc.)
    //      9    : SIGKILL (out-of-memory killer or scheduler pre-emption)
    //     97    : SLURM "Exceeded memory limit"
    //    104    : ECONNRESET — lost connection to the NFS/Lustre server
    //    134    : SIGABRT — internal abort sometimes raised by MPI or OOM conditions
    errorStrategy = { task.exitStatus in ((130..145) + [9, 97, 104, 134]) ? 'retry' : 'finish' }
    cache         = 'lenient'
    // Give the shared filesystem (NFS, Lustre, GPFS …) time to propagate output
    // files before the next task tries to read them.  10 s is a pragmatic default;
    // increase to 30-60 s on slow or heavily loaded file systems.
    afterScript   = 'sleep 10'

    resourceLimits = [
        // 1900 GB leaves ~100 GB headroom below a typical 2 TB scheduler hard-limit
        // while still allowing large-scale proteomics runs.  Adjust to match your
        // cluster's actual memory ceiling.
        memory: 1900.GB,
        cpus:   128,
        time:   30.d
    ]
}

executor {
    name              = 'slurm'
    queueSize         = 200
    // 10 submissions/sec is a safe default; raise (e.g. '20/1sec') if your
    // scheduler supports higher throughput or lower if you hit rate-limit errors.
    submitRateLimit   = '10/1sec'
    exitReadTimeout   = '30 min'
    queueGlobalStatus = true
    jobName           = {
        task.name
            .replace('[', '(')
            .replace(']', ')')
            .replace(' ', '_')
    }
}
