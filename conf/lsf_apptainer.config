/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running on IBM Spectrum LSF clusters using Apptainer
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    This profile is designed for HPC clusters managed by IBM Spectrum LSF (Load
    Sharing Facility) and using Apptainer as the container engine.

    Usage:
        nextflow run bigbio/quantms \
            -profile lsf_apptainer \
            --input project.sdrf.tsv \
            --database database.fasta \
            --outdir <OUTDIR>

    Configuration:
        The following parameters can be used to customise the profile:

        --apptainer_cache_dir   Path to the directory where Apptainer images are
                                cached (default: $HOME/.apptainer/cache).
        --apptainer_bind_dir    Path to bind-mount into the container, if your
                                input/output data is on a filesystem that Apptainer
                                does not auto-mount (default: null, no extra bind).
        --lsf_queue             LSF queue (bsub -q) to submit jobs to.
                                When null, the site default queue is used.

~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_description = 'Generic IBM Spectrum LSF cluster profile using Apptainer'
    config_profile_url         = 'https://www.ibm.com/products/hpc-workload-management'
    config_profile_contact     = 'https://github.com/bigbio/quantms/issues'

    // Optional: Path to a directory where Apptainer images should be cached.
    // Override via --apptainer_cache_dir on the command line.
    apptainer_cache_dir        = null

    // Optional: Extra bind-mount path (e.g. a shared project or scratch directory).
    // When set, this path is passed to apptainer.runOptions as --bind <path>.
    // Override via --apptainer_bind_dir on the command line.
    apptainer_bind_dir         = null

    // Optional: LSF queue name.  Leave null to use the cluster default.
    // Override via --lsf_queue on the command line.
    lsf_queue                  = null
}

apptainer {
    enabled     = true
    autoMounts  = true
    // Increase timeout from the default 20 min — large images can take much longer to pull.
    pullTimeout = '3 hours'
    cacheDir    = params.apptainer_cache_dir ?: "${HOME}/.apptainer/cache"
    runOptions  = params.apptainer_bind_dir ? "--bind ${params.apptainer_bind_dir}:${params.apptainer_bind_dir}" : ''
}

process {
    queue      = params.lsf_queue
    maxRetries = 5
    // Retry on transient HPC failures.  The exit-code groups cover:
    //   130-145 : termination signals (SIGTERM=143, scheduler pre-emption, etc.)
    //      9    : SIGKILL (out-of-memory killer or LSF RES_MEMLIMIT enforcement)
    //    104    : ECONNRESET — lost connection to NFS/GPFS
    //    134    : SIGABRT — internal abort sometimes raised under memory pressure
    errorStrategy = { task.exitStatus in ((130..145) + [9, 104, 134]) ? 'retry' : 'finish' }
    cache         = 'lenient'
    // Give the shared filesystem (NFS, GPFS, Spectrum Scale …) time to propagate
    // output files before the next task reads them.  10 s is a pragmatic default;
    // increase to 30-60 s on slow or heavily loaded file systems.
    afterScript   = 'sleep 10'

    resourceLimits = [
        // 1900 GB leaves ~100 GB headroom below a typical 2 TB per-node hard-limit.
        // Adjust to match your cluster's actual memory ceiling.
        memory: 1900.GB,
        cpus:   128,
        time:   30.d
    ]
}

executor {
    name            = 'lsf'
    queueSize       = 200
    // 10 submissions/sec is a safe default; raise (e.g. '20/1sec') if your
    // LSF bsub throughput allows it, or lower if you see submission errors.
    submitRateLimit = '10/1sec'
    exitReadTimeout = '30 min'
    jobName         = {
        task.name
            .replace('[', '(')
            .replace(']', ')')
            .replace(' ', '_')
    }
}
